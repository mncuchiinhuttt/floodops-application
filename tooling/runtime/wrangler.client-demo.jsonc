{
  "name": "floodops-synthetic-local-client-demo",
  "main": "../../apps/api/src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "SessionDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SessionDO"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "REPORT_MEDIA",
      "bucket_name": "floodops-composition-test-media",
      "remote": false
    },
    {
      "binding": "SCENARIO_ASSETS",
      "bucket_name": "floodops-composition-test-scenario-assets",
      "remote": false
    }
  ],
  "vars": {
    "APP_ENV": "test",
    "WEB_ORIGIN": "http://127.0.0.1:5174",
    "SESSION_LOCATOR_KEY": "synthetic-test-locator-never-use-remotely",
    "CAPABILITY_SEAL_KEY_ACTIVE": "synthetic-test-sealing-never-use-remotely",
    "CAPABILITY_SEAL_KEY_ID": "test-v1"
  },
  "images": {
    "binding": "IMAGES",
    "remote": false
  },
  "dev": {
    "ip": "127.0.0.1",
    "port": 8760
  }
}
