{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "floodops-sources-media-test",
  "main": "runtime-worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "SessionDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO"] }],
  "r2_buckets": [
    { "binding": "REPORT_MEDIA", "bucket_name": "sources-private-test-media", "remote": false },
    { "binding": "SCENARIO_ASSETS", "bucket_name": "sources-immutable-test-assets", "remote": false }
  ],
  "images": { "binding": "IMAGES", "remote": false },
  "vars": {
    "APP_ENV": "test",
    "WEB_ORIGIN": "https://floodops.test",
    "SESSION_LOCATOR_KEY": "synthetic-sources-test-locator-never-use-remotely",
    "CAPABILITY_SEAL_KEY_ACTIVE": "synthetic-sources-test-seal-key-never-use-remotely",
    "CAPABILITY_SEAL_KEY_ID": "sources-test-v1"
  }
}
