{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "floodops-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "SessionDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SessionDO"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "REPORT_MEDIA",
      "bucket_name": "floodops-local-report-media"
    }
  ],
  "vars": {
    "APP_ENV": "development",
    "WEB_ORIGIN": "http://127.0.0.1:5170"
  }
}

