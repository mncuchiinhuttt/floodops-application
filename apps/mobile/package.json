{
  "name": "@floodops/mobile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "dependencies": {
    "expo": "58.0.21",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "@floodops/contracts": "workspace:*",
    "@floodops/api-client": "workspace:*",
    "@floodops/design-tokens": "workspace:*",
    "@floodops/icons": "workspace:*",
    "@floodops/ui-native": "workspace:*",
    "@babel/runtime": "7.29.7",
    "expo-router": "58.0.28",
    "@expo/metro-runtime": "58.0.15",
    "react-native-screens": "4.30.0",
    "react-native-safe-area-context": "5.10.1",
    "expo-linking": "58.0.15",
    "expo-constants": "58.0.14",
    "expo-status-bar": "58.0.4",
    "expo-splash-screen": "58.0.12",
    "expo-font": "58.0.11",
    "expo-secure-store": "58.0.2",
    "expo-image-picker": "58.0.10",
    "expo-file-system": "58.0.13",
    "expo-crypto": "58.0.7",
    "expo-network": "58.0.4",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "@tanstack/react-query": "5.105.0",
    "@expo/log-box": "58.0.13"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.13",
    "@react-native/jest-preset": "0.88.1",
    "test-renderer": "1.3.0",
    "babel-jest": "30.5.2",
    "babel-preset-expo": "58.0.22",
    "@babel/core": "7.29.7",
    "@types/jest": "30.0.0",
    "@testing-library/react-native": "14.1.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts",
      "<rootDir>/test/**/*.test.tsx"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!\\.bun/|(?:@react-native(?:/|\\+)|react-native(?:/|-)|expo(?:/|-)|@expo(?:/|\\+)|@testing-library/react-native(?:/|\\+)))"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "watchman": false
  },
  "scripts": {
    "typecheck": "bun --bun run tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "start:local": "EXPO_NO_TELEMETRY=1 EXPO_OFFLINE=1 expo start --localhost --port 8082",
    "bundle:ios": "EXPO_NO_TELEMETRY=1 EXPO_OFFLINE=1 expo export --platform ios --output-dir dist/native-ios",
    "bundle:android": "EXPO_NO_TELEMETRY=1 EXPO_OFFLINE=1 expo export --platform android --output-dir dist/native-android"
  },
  "main": "expo-router/entry"
}
