# Backend-only local config. Copy manually only when creating your own ignored .env.
# Never put an API key in VITE_* or EXPO_PUBLIC_* variables, URLs, screenshots or Git.
OPENAI_API_KEY=
OPENAI_IMAGE_REVIEW_MODEL=
OPENAI_IMAGE_REVIEW_ENABLED=false
OPENAI_IMAGE_REVIEW_MAX_OUTPUT_TOKENS=512
# Config mapping: apiKey/model/enabled/maxOutputTokens in ResponsesImageReviewConfig.
# No model default, live-call budget or credential grant is supplied by this template.
# A key alone must not trigger live calls. Parent approves test fixture/cap separately.
