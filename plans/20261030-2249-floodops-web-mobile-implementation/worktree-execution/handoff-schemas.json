{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floodops.invalid/planning/worktree-handoff.schema.json",
  "$defs": {
    "LaunchReceipt": {
      "type": "object",
      "properties": {
        "work_item_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"
        },
        "role_id": {
          "type": "string",
          "enum": [
            "integration-lead",
            "contracts-client",
            "design-system",
            "simulation-data",
            "session-platform",
            "sources-media",
            "planner-safety",
            "review-rewards",
            "results-evaluation",
            "web-console",
            "expo-mobile",
            "quality-security",
            "release-ops"
          ]
        },
        "phase_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "uniqueItems": true
        },
        "base_sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "contract_ref": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "commit_sha": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "commit_sha",
            "sha256"
          ],
          "additionalProperties": false
        },
        "required_gates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "gate_id": {
                "type": "string",
                "enum": [
                  "plan-published",
                  "workspace-bootstrap",
                  "contracts-ready",
                  "backend-ready",
                  "ui-libraries-ready",
                  "combined-config-ready",
                  "qa-ready",
                  "release-authorized",
                  "simulation-ready",
                  "platform-ready",
                  "sources-ready",
                  "planner-ready",
                  "review-ready",
                  "results-ready",
                  "web-ready",
                  "mobile-ready",
                  "release-candidate-ready",
                  "calibration-validated",
                  "preview-authorized"
                ]
              },
              "commit_sha": {
                "type": "string",
                "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
              }
            },
            "required": [
              "gate_id",
              "commit_sha"
            ],
            "additionalProperties": false
          }
        },
        "expected_branch": {
          "type": "string",
          "minLength": 1
        },
        "expected_worktree": {
          "type": "string",
          "minLength": 1
        },
        "allowed_remote_push": {
          "type": "boolean"
        },
        "allowed_deployment": {
          "type": "boolean"
        },
        "status": {
          "const": "authorized"
        },
        "contract_mode": {
          "enum": [
            "bootstrap-authoring",
            "frozen-consumer",
            "approved-amendment"
          ]
        },
        "amendment_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"
        },
        "remote_authorizations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "grant_id": {
                "type": "string",
                "minLength": 3
              },
              "environment": {
                "enum": [
                  "development",
                  "preview",
                  "production"
                ]
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "deploy-preview",
                    "run-preview-checks",
                    "run-real-model",
                    "eas-development-build",
                    "eas-preview-build",
                    "deploy-production",
                    "submit-native-store",
                    "push-own-branch",
                    "promote-main"
                  ]
                }
              },
              "approval_reference": {
                "type": "string",
                "minLength": 1
              },
              "budget_reference": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "grant_id",
              "environment",
              "actions",
              "approval_reference",
              "budget_reference"
            ],
            "additionalProperties": false
          }
        },
        "policy_ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "const": "AGENTS.md"
            },
            "commit_sha": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "commit_sha",
            "sha256"
          ]
        }
      },
      "required": [
        "work_item_id",
        "role_id",
        "phase_ids",
        "base_sha",
        "contract_ref",
        "required_gates",
        "expected_branch",
        "expected_worktree",
        "allowed_remote_push",
        "allowed_deployment",
        "status",
        "contract_mode",
        "amendment_id",
        "remote_authorizations",
        "policy_ref"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "contract_mode": {
                "const": "approved-amendment"
              }
            },
            "required": [
              "contract_mode"
            ]
          },
          "then": {
            "properties": {
              "amendment_id": {
                "type": "string",
                "minLength": 3
              }
            }
          },
          "else": {
            "properties": {
              "amendment_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "allowed_deployment": {
                "const": true
              }
            },
            "required": [
              "allowed_deployment"
            ]
          },
          "then": {
            "properties": {
              "remote_authorizations": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "allowed_remote_push": {
                "const": true
              }
            },
            "required": [
              "allowed_remote_push"
            ]
          },
          "then": {
            "properties": {
              "remote_authorizations": {
                "contains": {
                  "properties": {
                    "actions": {
                      "contains": {
                        "enum": [
                          "push-own-branch",
                          "promote-main"
                        ]
                      }
                    }
                  },
                  "required": [
                    "actions"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "remote_authorizations": {
                "contains": {
                  "properties": {
                    "environment": {
                      "enum": [
                        "development",
                        "preview"
                      ]
                    },
                    "actions": {
                      "contains": {
                        "enum": [
                          "deploy-preview",
                          "run-preview-checks",
                          "run-real-model",
                          "eas-development-build",
                          "eas-preview-build"
                        ]
                      }
                    }
                  },
                  "required": [
                    "environment",
                    "actions"
                  ]
                }
              }
            },
            "required": [
              "remote_authorizations"
            ]
          },
          "then": {
            "properties": {
              "required_gates": {
                "contains": {
                  "properties": {
                    "gate_id": {
                      "const": "preview-authorized"
                    }
                  },
                  "required": [
                    "gate_id"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "remote_authorizations": {
                "contains": {
                  "properties": {
                    "actions": {
                      "contains": {
                        "enum": [
                          "deploy-production",
                          "submit-native-store",
                          "promote-main"
                        ]
                      }
                    }
                  },
                  "required": [
                    "actions"
                  ]
                }
              }
            },
            "required": [
              "remote_authorizations"
            ]
          },
          "then": {
            "properties": {
              "required_gates": {
                "contains": {
                  "properties": {
                    "gate_id": {
                      "const": "release-authorized"
                    }
                  },
                  "required": [
                    "gate_id"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "DeliveryReceipt": {
      "type": "object",
      "properties": {
        "work_item_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"
        },
        "role_id": {
          "type": "string",
          "enum": [
            "integration-lead",
            "contracts-client",
            "design-system",
            "simulation-data",
            "session-platform",
            "sources-media",
            "planner-safety",
            "review-rewards",
            "results-evaluation",
            "web-console",
            "expo-mobile",
            "quality-security",
            "release-ops"
          ]
        },
        "base_sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "observed_launch_sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "delivery_sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "status": {
          "type": "string",
          "enum": [
            "code-ready-for-integration",
            "blocked"
          ]
        },
        "contract_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  "unavailable"
                ]
              },
              "evidence_path": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "command",
              "cwd",
              "result",
              "evidence_path"
            ],
            "additionalProperties": false
          }
        },
        "smoke": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scenario": {
                "type": "string",
                "minLength": 1
              },
              "observed_result": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  "unavailable"
                ]
              },
              "evidence_path": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "scenario",
              "observed_result",
              "result",
              "evidence_path"
            ],
            "additionalProperties": false
          }
        },
        "public_exports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "integration_requests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked_prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out_of_scope_changes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "maxItems": 0
        },
        "unrequested_remote_actions": {
          "const": false
        },
        "source_sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "work_item_id",
        "role_id",
        "base_sha",
        "observed_launch_sha",
        "delivery_sha",
        "status",
        "contract_sha256",
        "changed_paths",
        "checks",
        "smoke",
        "public_exports",
        "integration_requests",
        "blocked_prerequisites",
        "out_of_scope_changes",
        "unrequested_remote_actions",
        "source_sha",
        "policy_sha256"
      ],
      "additionalProperties": false,
      "description": "Coordinator-owned accepted receipt written after exact delivery_sha is known; worker commits SourceEvidence instead, so no self-referential commit requirement."
    },
    "SourceEvidence": {
      "type": "object",
      "properties": {
        "work_item_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"
        },
        "role_id": {
          "type": "string",
          "enum": [
            "integration-lead",
            "contracts-client",
            "design-system",
            "simulation-data",
            "session-platform",
            "sources-media",
            "planner-safety",
            "review-rewards",
            "results-evaluation",
            "web-console",
            "expo-mobile",
            "quality-security",
            "release-ops"
          ]
        },
        "base_sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "observed_launch_sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "status": {
          "type": "string",
          "enum": [
            "code-ready-for-integration",
            "blocked"
          ]
        },
        "contract_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "cwd": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  "unavailable"
                ]
              },
              "evidence_path": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "command",
              "cwd",
              "result",
              "evidence_path"
            ],
            "additionalProperties": false
          }
        },
        "smoke": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scenario": {
                "type": "string",
                "minLength": 1
              },
              "observed_result": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  "unavailable"
                ]
              },
              "evidence_path": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "scenario",
              "observed_result",
              "result",
              "evidence_path"
            ],
            "additionalProperties": false
          }
        },
        "public_exports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "integration_requests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked_prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out_of_scope_changes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          },
          "maxItems": 0
        },
        "unrequested_remote_actions": {
          "const": false
        },
        "source_sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "work_item_id",
        "role_id",
        "base_sha",
        "observed_launch_sha",
        "status",
        "contract_sha256",
        "changed_paths",
        "checks",
        "smoke",
        "public_exports",
        "integration_requests",
        "blocked_prerequisites",
        "out_of_scope_changes",
        "unrequested_remote_actions",
        "source_sha",
        "policy_sha256"
      ],
      "additionalProperties": false,
      "description": "Worker report committed after source_sha; enclosing evidence/delivery commit SHA is submitted out of band and recorded only by IntegrationLead."
    }
  }
}
