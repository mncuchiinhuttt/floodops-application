{
  "name": "@floodops/ui-native",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@floodops/design-tokens": "workspace:*",
    "@floodops/icons": "workspace:*",
    "@babel/runtime": "7.29.7"
  },
  "peerDependencies": {
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "@types/react": "19.3.0",
    "expo": "58.0.21",
    "jest": "30.5.2",
    "jest-expo": "58.0.13",
    "@react-native/jest-preset": "0.88.1",
    "test-renderer": "1.3.0",
    "babel-jest": "30.5.2",
    "babel-preset-expo": "58.0.22",
    "@babel/core": "7.29.7",
    "@types/jest": "30.0.0",
    "@testing-library/react-native": "14.1.0"
  },
  "scripts": {
    "typecheck": "bun --bun run tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts",
      "<rootDir>/test/**/*.test.tsx"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!\\.bun/|(?:@react-native(?:/|\\+)|react-native(?:/|-)|expo(?:/|-)|@expo(?:/|\\+)|@testing-library/react-native(?:/|\\+)))"
    ]
  }
}
